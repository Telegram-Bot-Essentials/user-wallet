{
    "name": "telegram-bot-essentials/user-wallet",
    "description": "User wallet feature built for telegram-bot-essentials/essence",
    "type": "library",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12",
        "telegram-bot-essentials/billing": "^0.0",
        "telegram-bot-essentials/essence": "0.12.x-dev",
        "telegram-bot-essentials/settings": "^0.0"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "TelegramBotEssentials\\UserWallet\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "authors": [
        {
            "name": "Elyar",
            "email": "elyareranjbar@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "suggest": {
        "telegram-bot-essentials/user-management": "Adds wallet balance sorting to the bot users admin menu."
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Elyar0/telegram-bot-essentials"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Elyar0/tbe-billing"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Elyar0/tbe-settings"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "TelegramBotEssentials\\UserWallet\\TbeUserWalletServiceProvider"
            ]
        }
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ]
    }
}
